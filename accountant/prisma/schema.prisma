// This is your Prisma schema file (data models only).
// Configuration is in prisma.config.ts at the project root.

generator client {
  provider               = "prisma-client"
  output                 = "../server/prisma"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                   Int        @id @default(autoincrement())
  username             String     @unique
  first_name           String?    @map("first_name")
  last_name            String?    @map("last_name")
  email                String     @unique
  password_hash        String     @map("password_hash")
  type                 UserType   @default(STUDENT)
  verification_token   String?    @map("verification_token")
  verification_sent_at DateTime?  @map("verification_sent_at")
  reset_token          String?    @map("reset_token")
  reset_sent_at        DateTime?  @map("reset_sent_at")
  created_at           DateTime   @default(now()) @map("created_at")
  updated_at           DateTime   @default(now()) @map("updated_at")

  taught_offerings     Offering[] @relation("TeacherOfferings")
  assignments          Assignment[]

  @@index([username])
  @@index([email])
  @@map("users")
}

enum UserType {
  STUDENT
  TEACHER
  ADMIN
}

model Class {
  id            Int      @id @default(autoincrement())
  subject       String   @map("subject")
  number        String
  title         String

  offerings     Offering[]

  @@unique([subject, number])
  @@index([subject])
  @@map("classes")
}

// An offering can be co-taught: the teacher list is an implicit many-to-many
// relation (Prisma manages a `_TeacherOfferings` join table with cascade
// deletes on both sides). scripts/migrate-multi-teacher.mjs moves existing
// single-teacher databases over to this shape.
model Offering {
  id          Int      @id @default(autoincrement())
  class_id    Int      @map("class_id")
  term        String
  section     String

  class       Class    @relation(fields: [class_id], references: [id], onDelete: Cascade)
  teachers    User[]   @relation("TeacherOfferings")
  projects    Project[]

  @@unique([class_id, term, section])
  @@index([class_id])
  @@map("offerings")
}

model Project {
  id               Int      @id @default(autoincrement())
  offering_id      Int      @map("offering_id")
  title            String
  slug             String   @unique
  type             ProjectType @default(OTHER)
  repository_url   String?        @map("repository_url")
  repository_type  RepositoryType @default(SUBVERSION)
  description      String?

  offering         Offering @relation(fields: [offering_id], references: [id], onDelete: Cascade)
  assignments      Assignment[]

  @@index([offering_id])
  @@map("projects")
}

enum ProjectType {
  UNITY_ENGINE
  UNREAL_ENGINE_5
  GODOT
  OTHER
}

// Kind of version-control system backing a project's repository_url.
enum RepositoryType {
  SUBVERSION
  GIT
  PERFORCE
  LORE
  OTHER
}

model Assignment {
  student_id  Int  @map("student_id")
  project_id  Int  @map("project_id")

  student     User    @relation(fields: [student_id], references: [id], onDelete: Cascade)
  project     Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@id([student_id, project_id])
  @@map("assignments")
}
