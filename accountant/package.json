{
  "name": "accountant",
  "version": "1.0.0",
  "description": "A backend SVN account management tool with email verification.",
  "keywords": [
    "subversion",
    "SVN",
    "accounts",
    "REST",
    "API"
  ],
  "license": "MIT",
  "author": "Seth Berrier",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/server.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server/server.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@types/better-sqlite3": "^9.6.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.5",
    "neostandard": "^0.13.0",
    "prisma": "^7.10.0",
    "vite": "^8.3.1"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true
  }
}
