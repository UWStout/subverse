{
  "name": "accountant",
  "version": "1.0.0",
  "description": "A backend SVN account management tool with email verification.",
  "keywords": [
    "subversion",
    "SVN",
    "accounts",
    "REST",
    "API"
  ],
  "license": "MIT",
  "author": "Seth Berrier",
  "type": "module",
  "scripts": {
    "dev:server": "node --watch server/server.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/server.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
